# === Agent Controller (Text-Only Orchestration) ===
OPENAI_API_KEY=

# === Primary RS VLM (EarthDial on RunPod) ===
# Change RS_VLM_PROVIDER to "runpod" and set endpoint + key to activate
RS_VLM_PROVIDER=fallback
RS_VLM_ENDPOINT=
RS_VLM_API_KEY=
RS_VLM_MODEL=EarthDial_4B
RS_VLM_TIMEOUT=60
RS_VLM_MAX_RETRIES=3

# === Optional Secondary VLM (e.g., GeoChat) ===
SECONDARY_VLM_ENDPOINT=
SECONDARY_VLM_API_KEY=
SECONDARY_VLM_MODEL=

# === Specialist Models ===
CHANGE_MODEL_ENDPOINT=
CHANGE_MODEL_API_KEY=
FUSION_MODEL_ENDPOINT=
FUSION_MODEL_API_KEY=
GROUNDING_MODEL_ENDPOINT=
GROUNDING_MODEL_API_KEY=

# === Runtime ===
RS_VLM_LOCAL=false
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=100
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
